<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Self-update: the app downloads its own APK from the bridge and installs
         it through PackageInstaller, so no adb pairing is needed. The user still
         has to allow "install unknown apps" once, and confirm each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The build-plus-download runs for minutes, so it outlives the screen it
         was started from and needs a foreground service to survive backgrounding. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".ScoutrApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scoutr"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="scoutr" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".service.NotificationReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.NotificationMuteReceiver"
            android:exported="false" />

        <service
            android:name=".service.ScoutrMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Install session callbacks; only the system's own PendingIntent
             targets this, so it stays unexported. -->
        <receiver
            android:name=".update.ApkInstallReceiver"
            android:exported="false" />

        <!-- Cancel/Resume from the update notification's own actions. -->
        <receiver
            android:name=".update.UpdateActionReceiver"
            android:exported="false" />

        <!-- Holds the process open for one self-update. dataSync may only be
             started from the foreground; every start path obeys that. -->
        <service
            android:name=".update.UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>

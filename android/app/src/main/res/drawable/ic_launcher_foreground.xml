<?xml version="1.0" encoding="utf-8"?>
<!--
    `scoutr_icon.png` is a finished rounded-square tile. AdaptiveIconDrawable
    stretches the foreground to 150% of the *view* size (not 108dp) and the
    launcher mask keeps only the inner 66%. An absolute 72dp child fills that
    stretched layer whenever the icon is drawn smaller than ~108dp — recents,
    the shelf, most launchers — so the mask centre-crops the tile and slices
    the pipes. Percentage inset tracks the layer bounds at every size: 18%
    leaves the tile just inside the 66% viewport (16.7% would be flush).
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/scoutr_icon"
    android:inset="18%" />

<?xml version="1.0" encoding="utf-8"?>
<!--
    The Scoutr mark as a notification small icon: two periscopes on a flanged
    base, reduced to a flat silhouette. Android draws a small icon as an alpha
    mask and applies its own tint, so this carries no color of its own — the
    presenter tints it `#E5484D`.

    Drawn as three paths rather than one because the arms overlap the ring
    heads: a single `evenOdd` path would punch the overlap back out, and the
    rings need `evenOdd` to stay open. Separate fills union cleanly instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Base flange and both periscope bodies. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3,20 h14 a1,1 0 0 1 0,2 h-14 a1,1 0 0 1 0,-2 z
                          M5,20 V9 a4,4 0 0 1 4,-4 h3.5 v3 h-3.5 a1,1 0 0 0 -1,1 v11 z
                          M10,20 V15 a3.5,3.5 0 0 1 3.5,-3.5 h2.8 v3 h-2.8 a1,1 0 0 0 -1,1 v4.5 z" />

    <!-- Upper head. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M11,6.5 a3.3,3.3 0 1 1 6.6,0 a3.3,3.3 0 1 1 -6.6,0 z
                          M12.7,6.5 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0 z" />

    <!-- Lower head. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M15,13 a2.8,2.8 0 1 1 5.6,0 a2.8,2.8 0 1 1 -5.6,0 z
                          M16.4,13 a1.4,1.4 0 1 0 2.8,0 a1.4,1.4 0 1 0 -2.8,0 z" />
</vector>

{
  "name": "scoutr-bridge",
  "version": "0.1.0",
  "description": "Bridge daemon: owns the local herdr socket and pi sessions, exposes a token-authenticated loopback API for the Scoutr Android app, published through the configured exposure (Tailscale, Cloudflare Tunnel, or a custom proxy).",
  "private": true,
  "type": "module",
  "bin": {
    "scoutr-bridge": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.config.ts src test",
    "build": "tsc",
    "deploy": "npm run build && node ../scripts/bridge-service.mjs restart && npm run check:deployed",
    "check:deployed": "node scripts/check-deployed.mjs",
    "test": "node --import tsx --test --test-timeout=120000 test/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "google-auth-library": "^11.0.2",
    "qrcode-terminal": "^0.12.0",
    "valibot": "^1.4.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true
  }
}
